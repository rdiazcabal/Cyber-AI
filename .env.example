# LLM Providers
GROQ_API_KEY=change-me
# Use a model enabled in the Groq project Model Permissions.
# Do not use deprecated/unsuitable models:
# - llama-3.1-8b-instant
# - llama-3.3-70b-versatile
# - meta-llama/llama-prompt-guard-2-22m
GROQ_MODEL=qwen/qwen3.6-27b

# Threat Intel
ABUSEIPDB_API_KEY=change-me

# Initial super admin
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
ADMIN_COMPANY=Cyber-AI Internal

# JWT
JWT_SECRET_KEY=change-me-super-secret-key

# SQLite local/default
DATABASE_FILE=/app/data/cyber_ai.db

# PostgreSQL/RDS option
# DATABASE_URL=postgresql+psycopg2://cyber_ai_user:change-me@cyber-ai.xxxxxxxxxxxx.us-east-1.rds.amazonaws.com:5432/cyber_ai
